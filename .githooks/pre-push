#!/bin/sh
# pre-push: refuse to push a commit whose headline counts are stale, or whose
# content has a structural error (scripts/content-integrity.mjs: duplicate ID,
# answer key missing from the options, empty answer; its warnings never block),
# or whose data files do not parse strictly (scripts/strict-data.mjs).
# It also WARNS (never blocks) when the push changes content data files that no
# "/amac-audit changed" run covers (.claude/skills/amac-audit/audit-tool.mjs coverage).
#
# Install once per clone:   git config core.hooksPath .githooks
#
# For every commit being pushed, runs that commit's own count check against
# that commit's files (not the working tree, so uncommitted edits cannot hide
# or cause a failure). If anything is stale, the push is blocked: run the
# count script named in the message, commit the result, and push again.
#
# Since Oct 2026 the check is scripts/sync-counts.mjs (Node). Older commits
# still carry _tools/build-counts.py (or build-counts.py at the root before
# 24 Sep 2026) and are checked with Python as before.

zero=0000000000000000000000000000000000000000

find_python() {
  for c in python python3 py; do
    if "$c" -c 'import sys' >/dev/null 2>&1; then echo "$c"; return; fi
  done
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion

  if git cat-file -e "$local_sha:scripts/sync-counts.mjs" 2>/dev/null; then
    if ! command -v node >/dev/null 2>&1; then
      echo "pre-push: no Node found, cannot check counts. Push blocked." >&2
      exit 1
    fi
    run="node"; script=scripts/sync-counts.mjs; fix="node scripts/sync-counts.mjs"
    paths="scripts data stations paces-stations *.html *.js"
  else
    script=
    for s in _tools/build-counts.py build-counts.py; do
      if git cat-file -e "$local_sha:$s" 2>/dev/null; then script=$s; break; fi
    done
    if [ -z "$script" ]; then
      echo "pre-push: WARNING - no count script found in $local_ref ($local_sha); counts NOT checked." >&2
      continue
    fi
    run=$(find_python)
    if [ -z "$run" ]; then
      echo "pre-push: no Python found, cannot check counts. Push blocked." >&2
      exit 1
    fi
    fix="python $script"
    paths="$script data stations/index.json *.html *.js"
  fi

  tmp=$(mktemp -d) || exit 1
  # shellcheck disable=SC2086  # $paths is a list of pathspecs
  set -f                                         # pass the globs to git, not the shell
  git archive "$local_sha" -- $paths | tar -x -C "$tmp"
  set +f
  if ! out=$("$run" "$tmp/$script" --check 2>&1); then
    echo "pre-push: counts are stale in $local_ref ($local_sha):" >&2
    echo "$out" | grep -E 'stale:|MARKUP PROBLEMS|COULD NOT COUNT|^  - ' >&2
    echo "Run  $fix , commit, and push again." >&2
    status=1
  fi
  if [ -f "$tmp/scripts/content-integrity.mjs" ]; then
    if ! out=$(node "$tmp/scripts/content-integrity.mjs" 2>&1); then
      echo "pre-push: structural content errors in $local_ref ($local_sha):" >&2
      echo "$out" | awk '/^x /{p=1; print; next} /^(! |$)/{p=0} p' | head -40 >&2
      echo "Run  node scripts/content-integrity.mjs , fix the FAIL items, commit, and push again." >&2
      status=1
    fi
  fi
  if [ -f "$tmp/scripts/strict-data.mjs" ]; then
    if ! out=$(node "$tmp/scripts/strict-data.mjs" 2>&1); then
      echo "pre-push: data files do not parse strictly in $local_ref ($local_sha):" >&2
      echo "$out" | grep -E '^  \[' | head -40 >&2
      echo "Run  node scripts/strict-data.mjs , fix each file:line, commit, and push again." >&2
      status=1
    fi
  fi
  rm -rf "$tmp"

  # Content audit coverage: a WARNING only, never blocks. If this push changes
  # content data files that no "/amac-audit changed" run has covered, say so.
  tool="$(git rev-parse --show-toplevel)/.claude/skills/amac-audit/audit-tool.mjs"
  if [ -f "$tool" ] && command -v node >/dev/null 2>&1; then
    if [ "$remote_sha" = "$zero" ]; then
      from=$(git merge-base origin/main "$local_sha" 2>/dev/null)
    else
      from=$remote_sha
    fi
    node "$tool" coverage --commit "$local_sha" ${from:+--from "$from"} >&2 || true
  fi
done
exit $status
